/* GD32F470VGT6 memory map（GD32F4xx UM memory map + 板上 openocd 逐段探测定案 2026-09-29）
 *
 * 主 SRAM 实测 448KB 连续 @ 0x20000000：
 *   SRAM0  112KB 0x20000000-0x2001BFFF
 *   SRAM1   16KB 0x2001C000-0x2001FFFF
 *   SRAM2   64KB 0x20020000-0x2002FFFF
 *   ADDSRAM 256KB 0x20030000-0x2006FFFF  （0x20070000 起总线错误，实测）
 *   宣传"512KB SRAM"含 TCMSRAM 64KB @ 0x10000000（仅内核 DBUS，DMA 禁入），
 *   448K = 512K - 64K。
 * 警告：0x20070000 起写入触发总线错误（曾致 512K 版 memory.x 栈顶 HardFault）。
 */
MEMORY
{
  FLASH : ORIGIN = 0x08000000, LENGTH = 1024K
  RAM   : ORIGIN = 0x20000000, LENGTH = 448K
}
